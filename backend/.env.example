# Скопируй в .env и заполни. Файл .env в git не коммитится.

# Подключение к PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL=postgresql+psycopg://kitfinder:kitfinder@localhost:5432/kitfinder

# Аутентификация админа (появится на этапе M1)
# ADMIN_PASSWORD_HASH — bcrypt-хеш пароля, сгенерировать один раз
ADMIN_PASSWORD_HASH=
# SECRET_KEY — для подписи cookie-сессии, случайная строка
SECRET_KEY=
